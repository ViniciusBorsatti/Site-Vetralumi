---
import { empresa, linkWhatsapp } from '../data/empresa';

const acao = empresa.whatsapp ? linkWhatsapp(empresa.whatsapp) : `tel:${empresa.telefone.e164}`;
---

<section class="secao secao--escura">
  <div class="env">
    <div class="rev">
      <p class="etiqueta">Por que a Vetralumi</p>
      <h2 class="titulo">Peça certa, na hora certa</h2>
    </div>

    <div class="grade">
      {
        empresa.diferenciais.map((d, i) => (
          <article class="item rev" style={`--atraso:${(i * 0.09).toFixed(2)}s`}>
            <span class="risco" />
            <h3>{d.titulo}</h3>
            <p>{d.descricao}</p>
          </article>
        ))
      }
    </div>

    <div class="chamada rev">
      <p>Precisa de uma peça específica ou quer condições para revenda?</p>
      <a class="btn btn--cheio" href={acao} target="_blank" rel="noopener">Falar com a loja</a>
    </div>
  </div>
</section>

<style>
  .grade {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(255px, 1fr));
    gap: 34px;
    margin-top: 50px;
  }

  .risco {
    display: block;
    width: 38px;
    height: 2px;
    background: var(--azul);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.7s var(--saida) 0.2s;
  }

  .rev.visto .risco {
    transform: scaleX(1);
  }

  .item h3 {
    margin-top: 20px;
    font-size: 1.22rem;
    font-weight: 600;
  }

  .item p {
    margin-top: 12px;
    color: #9aa1ac;
    font-size: 16px;
    line-height: 1.6;
  }

  .chamada {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 60px;
    padding-top: 34px;
    border-top: 1px solid #26282e;
  }

  .chamada p {
    font-size: 19px;
    font-weight: 500;
  }
</style>
