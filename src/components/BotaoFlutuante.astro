---
import { empresa, linkWhatsapp } from '../data/empresa';
---

{
  empresa.whatsapp && (
    <a
      class="flutuante"
      id="flutuante"
      href={linkWhatsapp(empresa.whatsapp)}
      target="_blank"
      rel="noopener"
      aria-label="Falar no WhatsApp"
    >
      <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
        <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.86 9.86 0 0 0 12.04 2zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.17 8.17 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23a8.2 8.2 0 0 1 8.24 8.24c0 4.54-3.7 8.23-8.24 8.23zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.79.97-.14.16-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.24-1.47-1.38-1.72-.15-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.13-.15.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.35-.77-1.85-.2-.48-.4-.42-.56-.43h-.47c-.17 0-.43.06-.66.31-.22.25-.87.85-.87 2.07s.89 2.4 1.02 2.56c.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.14-1.18-.06-.11-.22-.17-.47-.29z" />
      </svg>
    </a>
  )
}

<style>
  .flutuante {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 60;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: #25d366;
    color: #fff;
    box-shadow: 0 10px 26px -8px rgba(37, 211, 102, 0.75);
    opacity: 0;
    transform: translateY(16px) scale(0.9);
    pointer-events: none;
    transition:
      opacity 0.45s var(--saida),
      transform 0.45s var(--saida);
  }

  .flutuante.aparece {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .flutuante:hover {
    transform: translateY(-3px);
  }
</style>

<script>
  const botao = document.getElementById('flutuante');
  let pendente = false;

  function aoRolar(): void {
    botao?.classList.toggle('aparece', window.scrollY > 520);
    pendente = false;
  }

  window.addEventListener(
    'scroll',
    () => {
      if (!pendente) {
        pendente = true;
        window.requestAnimationFrame(aoRolar);
      }
    },
    { passive: true },
  );

  aoRolar();
</script>
