---
import { empresa } from '../data/empresa';
---

<section class="secao" id="para-quem">
  <div class="env">
    <div class="rev">
      <p class="etiqueta">Atendimento</p>
      <h2 class="titulo">Para quem trabalha com alumínio</h2>
    </div>

    <div class="publicos">
      {
        empresa.publicos.map((p, i) => (
          <article class="publico rev" style={`--atraso:${(i * 0.09).toFixed(2)}s`}>
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{p.titulo}</h3>
            <p>{p.descricao}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .publicos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1px;
    background: var(--linha);
    border-top: 1px solid var(--linha);
    margin-top: 46px;
  }

  .publico {
    background: var(--branco);
    padding: 34px 28px 30px;
    transition:
      opacity 0.8s var(--saida),
      transform 0.8s var(--saida),
      background 0.35s var(--suave);
  }

  .publico:hover {
    background: var(--nevoa);
  }

  .num {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--azul);
    letter-spacing: 0.1em;
  }

  .publico h3 {
    margin-top: 14px;
    font-size: 1.22rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .publico p {
    margin-top: 12px;
    color: var(--cinza);
    font-size: 16px;
    line-height: 1.6;
  }
</style>
