 * exatos a partir do logotipo. Ficam em paths separados para poderem ser
 * animadas de forma independente. A cor vem de currentColor.
 */
---

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <symbol id="marca-v" viewBox="0 0 161 146">
    <path class="lamina lamina--esq" d="M0 0.5 L80.9 146 L99 113.8 L41.1 0.5 Z" fill="currentColor" />
    <path class="lamina lamina--dir" d="M160.7 4.5 L116.5 13.1 L86 68.8 L103.7 105.3 L124.5 68.5 Z" fill="currentColor" />
  </symbol>
</svg>
