---
import { empresa, linkWhatsapp } from '../data/empresa';

const acao = empresa.whatsapp ? linkWhatsapp(empresa.whatsapp) : `tel:${empresa.telefone.e164}`;
const { rede } = empresa;
const listaUf = rede.estados.join(', ');
---

<section class="secao" id="rede">
  <div class="env">
    <div class="rev">
      <p class="etiqueta">Distribuição</p>
      <h2 class="titulo">O começo de uma grande rede</h2>
      <p class="chamada-secao">{rede.texto}</p>
    </div>

    <div class="rede-grade">
      <div class="rev" style="--atraso:.08s">
        <div class="contador">
          <span class="numero" id="contador" data-alvo={rede.distribuidores}>0</span>
          <span class="legenda">
            distribuidores<br />
            em {rede.estados.length} estados
          </span>
        </div>

        <ul class="estados">
          {
            rede.estados.map((uf, i) => (
              <li class="uf" style={`--atraso:${(i * 0.05).toFixed(2)}s`}>
                {uf}
              </li>
            ))
          }
        </ul>
      </div>

      <figure class="mapa quadro rev" style="--atraso:.16s">
        <span class="quadro-rotulo">Cobertura — {rede.estados.length} UF</span>
        <img
          src="/mapa-rede.png"
          alt={`Mapa do Brasil com os estados atendidos pela Vetralumi: ${listaUf}`}
          width="900"
          height="896"
          loading="lazy"
        />
      </figure>
    </div>

    <div class="chamada rev">
      <p>Quer distribuir a linha Vetralumi na sua região?</p>
      <a class="btn btn--cheio" href={acao} target="_blank" rel="noopener">Falar com a empresa</a>
    </div>
  </div>
</section>

<style>
  .rede-grade {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
    margin-top: 48px;
  }
  .rede-grade > * {
    min-width: 0;
  }


  .contador {
    display: flex;
    align-items: baseline;
    gap: 16px;
  }

  .numero {
    font-family: var(--mono);
    font-size: clamp(4rem, 9vw, 6.5rem);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.05em;
    color: var(--azul);
    font-variant-numeric: tabular-nums;
  }

  .legenda {
    font-size: 20px;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .estados {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin-top: 32px;
    padding-top: 28px;
    border-top: 1px solid var(--linha);
  }

  .uf {
    padding: 9px 18px;
    background: var(--branco);
    border: 1px solid var(--linha);
    font-family: var(--mono);
    font-size: 14px;
    letter-spacing: 0.1em;
    transition:
      border-color 0.35s var(--suave),
      color 0.35s var(--suave);
  }

  .uf:hover {
    border-color: var(--azul);
    color: var(--azul);
  }

  .mapa {
    display: grid;
    place-items: center;
    padding: 36px 26px 26px;
  }

  .mapa img {
    width: 100%;
    max-width: 470px;
    height: auto;
  }

  .chamada {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 54px;
    padding-top: 32px;
    border-top: 1px solid var(--linha);
  }

  .chamada p {
    font-size: 19px;
    font-weight: 500;
  }

  @media (max-width: 860px) {
    .rede-grade {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>

<script>
  const alvo = document.getElementById('contador');
  const reduzir = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (alvo) {
    const destino = Number(alvo.dataset.alvo ?? 0);

    if (reduzir || !('IntersectionObserver' in window)) {
      alvo.textContent = String(destino);
    } else {
      const obs = new IntersectionObserver(
        (entradas) => {
          for (const e of entradas) {
            if (!e.isIntersecting) continue;
            obs.unobserve(e.target);
            const inicio = performance.now();
            const dur = 1100;
            const passo = (agora: number): void => {
              const t = Math.min((agora - inicio) / dur, 1);
              const suave = 1 - Math.pow(1 - t, 3);
              alvo.textContent = String(Math.round(destino * suave));
              if (t < 1) window.requestAnimationFrame(passo);
            };
            window.requestAnimationFrame(passo);
          }
        },
        { threshold: 0.5 },
      );
      obs.observe(alvo);
    }
  }
</script>
