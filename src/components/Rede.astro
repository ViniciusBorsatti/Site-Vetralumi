---
import { empresa, linkWhatsapp } from '../data/empresa';

const acao = empresa.whatsapp ? linkWhatsapp(empresa.whatsapp) : `tel:${empresa.telefone.e164}`;
const { rede } = empresa;
---

<section class="secao secao--escura" id="rede">
  <div class="env">
    <div class="rede-topo">
      <div class="rev">
        <p class="etiqueta">Distribuição</p>
        <h2 class="titulo">O começo de uma grande rede</h2>
        <p class="chamada-secao">{rede.texto}</p>
      </div>

      <div class="contador rev" style="--atraso:.1s">
        <span class="numero" id="contador" data-alvo={rede.distribuidores}>0</span>
        <span class="legenda">distribuidores</span>
      </div>
    </div>

    <ul class="estados rev" style="--atraso:.18s">
      {
        rede.estados.map((uf, i) => (
          <li class="uf" style={`--atraso:${(i * 0.05).toFixed(2)}s`}>
            {uf}
          </li>
        ))
      }
    </ul>

    <div class="chamada rev">
      <p>Quer distribuir a linha Vetralumi na sua região?</p>
      <a class="btn btn--cheio" href={acao} target="_blank" rel="noopener">Falar com a empresa</a>
    </div>
  </div>
</section>

<style>
  .rede-topo {
    display: grid;
    grid-template-columns: 1.4fr 0.6fr;
    gap: 40px;
    align-items: center;
  }

  .contador {
    text-align: right;
  }

  .numero {
    display: block;
    font-size: clamp(4rem, 11vw, 8rem);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.05em;
    color: var(--azul);
    font-variant-numeric: tabular-nums;
  }

  .legenda {
    display: block;
    margin-top: 8px;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #9aa1ac;
  }

  .estados {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
    margin-top: 44px;
    padding-top: 34px;
    border-top: 1px solid #26282e;
  }

  .uf {
    padding: 10px 20px;
    border: 1px solid #2e3138;
    border-radius: 2px;
    font-family: var(--mono);
    font-size: 14px;
    letter-spacing: 0.1em;
    transition:
      border-color 0.35s var(--suave),
      color 0.35s var(--suave);
  }

  .uf:hover {
    border-color: var(--azul);
    color: var(--azul);
  }

  .chamada {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 54px;
    padding-top: 32px;
    border-top: 1px solid #26282e;
  }

  .chamada p {
    font-size: 19px;
    font-weight: 500;
  }

  @media (max-width: 780px) {
    .rede-topo {
      grid-template-columns: 1fr;
      gap: 26px;
    }
    .contador {
      text-align: left;
    }
  }
</style>

<script>
  const alvo = document.getElementById('contador');
  const reduzir = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (alvo) {
    const destino = Number(alvo.dataset.alvo ?? 0);

    if (reduzir || !('IntersectionObserver' in window)) {
      alvo.textContent = String(destino);
    } else {
      const obs = new IntersectionObserver(
        (entradas) => {
          for (const e of entradas) {
            if (!e.isIntersecting) continue;
            obs.unobserve(e.target);
            const inicio = performance.now();
            const dur = 1100;
            const passo = (agora: number): void => {
              const t = Math.min((agora - inicio) / dur, 1);
              const suave = 1 - Math.pow(1 - t, 3);
              alvo.textContent = String(Math.round(destino * suave));
              if (t < 1) window.requestAnimationFrame(passo);
            };
            window.requestAnimationFrame(passo);
          }
        },
        { threshold: 0.5 },
      );
      obs.observe(alvo);
    }
  }
</script>
