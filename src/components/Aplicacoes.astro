---
import { empresa } from '../data/empresa';
---

<section class="secao" id="aplicacoes">
  <div class="env">
    <div class="rev">
      <p class="etiqueta">Aplicações</p>
      <h2 class="titulo">Onde a dobradiça com mola entra</h2>
      <p class="chamada-secao">
        Toda aplicação em que a porta precisa voltar sozinha para a posição fechada.
      </p>
    </div>

    <div class="grade">
      {
        empresa.aplicacoes.map((a, i) => (
          <article class="item rev" style={`--atraso:${(i * 0.08).toFixed(2)}s`}>
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{a.titulo}</h3>
            <p>{a.descricao}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .grade {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1px;
    background: var(--linha);
    border-top: 1px solid var(--linha);
    margin-top: 44px;
  }

  .item {
    background: var(--branco);
    padding: 32px 26px 28px;
    transition:
      opacity 0.8s var(--saida),
      transform 0.8s var(--saida),
      background 0.35s var(--suave);
  }

  .item:hover {
    background: var(--nevoa);
  }

  .num {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--azul);
    letter-spacing: 0.1em;
  }

  .item h3 {
    margin-top: 13px;
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .item p {
    margin-top: 11px;
    color: var(--cinza);
    font-size: 16px;
    line-height: 1.6;
  }
</style>
