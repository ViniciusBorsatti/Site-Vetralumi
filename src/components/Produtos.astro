---
import { empresa } from '../data/empresa';

/* Colunas que dividem a contagem exata de especificações: assim a última
   linha da tabela nunca fica pela metade. */
const colunas = (n: number): number => (n % 3 === 0 ? 3 : n % 2 === 0 ? 2 : 3);
---

<section class="secao secao--branca" id="produtos">
  <div class="env">
    <div class="rev">
      <p class="etiqueta">Linha de produtos</p>
      <h2 class="titulo">O que a Vetralumi fabrica</h2>
    </div>

    {
      empresa.produtos.map((p, idx) => (
        <article class="produto rev" style={`--atraso:${(idx * 0.06).toFixed(2)}s`}>
          <div class="produto-visual quadro">
            <span class="quadro-rotulo">{p.subtitulo}</span>
            {p.lancamento && <span class="selo">Lançamento</span>}
            <img
              id={`foto-${p.id}`}
              src={p.imagem}
              data-atual={p.imagem}
              alt={`${p.nome} Vetralumi`}
              width="532"
              height="620"
              loading="lazy"
            />
          </div>

          <div class="produto-texto">
            <p class="subtitulo">{p.subtitulo}</p>
            <h3>{p.nome}</h3>
            <p class="descricao">{p.descricao}</p>

            {p.acabamentos && (
              <div class="acabamentos">
                <span class="acab-rotulo">Acabamentos</span>
                <div class="acab-lista">
                  {p.acabamentos.map((a, i) => (
                    <button
                      class:list={['acab', { ativo: i === 1 }]}
                      data-imagem={a.imagem}
                      data-alvo={`foto-${p.id}`}
                      type="button"
                    >
                      <span class="chip" style={`background:${a.chip}`} aria-hidden="true" />
                      {a.nome}
                      {a.novidade && <em>novo</em>}
                    </button>
                  ))}
                </div>
              </div>
            )}

            <dl class="tabela fichas" style={`--cols:${colunas(p.especificacoes.length)}`}>
              {p.especificacoes.map((e) => (
                <div class="ficha">
                  <dt>{e.rotulo}</dt>
                  <dd>{e.valor}</dd>
                </div>
              ))}
            </dl>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .produto {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(28px, 4vw, 56px);
    align-items: center;
    background: var(--branco);
    border: 1px solid var(--linha);
    padding: clamp(22px, 3.2vw, 42px);
    margin-top: 40px;
  }
  .produto > * {
    min-width: 0;
  }


  .produto-visual {
    display: grid;
    place-items: center;
    min-height: 280px;
    background: var(--palco);
    padding: 34px 22px 22px;
  }

  .produto-visual img {
    width: auto;
    max-width: 100%;
    max-height: 252px;
    object-fit: contain;
    transition: opacity 0.28s var(--suave);
  }

  .produto-visual img.trocando {
    opacity: 0;
  }

  .selo {
    position: absolute;
    top: 9px;
    right: 9px;
    z-index: 2;
    background: var(--azul);
    color: #fff;
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 5px 10px;
  }

  .subtitulo {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--azul-rotulo);
  }

  .produto-texto h3 {
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-top: 9px;
  }

  .descricao {
    margin-top: 12px;
    color: var(--cinza);
    font-size: 16px;
    max-width: 52ch;
  }

  .acabamentos {
    margin-top: 24px;
  }

  .acab-rotulo {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cinza-claro);
  }

  .acab-lista {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 10px;
  }

  .acab {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 13px;
    border: 1px solid var(--linha);
    border-radius: 0;
    background: var(--branco);
    font-family: inherit;
    font-size: 13px;
    color: var(--tinta);
    cursor: pointer;
    transition:
      border-color 0.3s var(--suave),
      background 0.3s var(--suave);
  }

  .acab:hover {
    border-color: var(--azul);
  }

  .acab.ativo {
    border-color: var(--azul);
    background: var(--azul-fraco);
  }

  .acab em {
    font-style: normal;
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--azul-rotulo);
  }

  .chip {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    border: 1px solid var(--linha);
    flex: none;
  }

  .fichas {
    grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr));
    margin-top: 22px;
  }

  @media (max-width: 1080px) {
    .fichas {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 460px) {
    .fichas {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 860px) {
    .produto {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const botoes = document.querySelectorAll<HTMLButtonElement>('.acab');

  /* Os acabamentos são PNGs grandes. Sem pré-carregar, o primeiro clique
     esperava o download inteiro e a foto entrava de estalo. */
  function precarregar(): void {
    const vistos = new Set<string>();
    botoes.forEach((b) => {
      const src = b.dataset.imagem;
      if (src && !vistos.has(src)) {
        vistos.add(src);
        new Image().src = src;
      }
    });
  }

  /* Resolve quando a imagem estiver pronta. Nunca rejeita e nunca fica pendente:
     erro e estouro de prazo também resolvem, para a foto sempre reaparecer. */
  function carregada(src: string): Promise<void> {
    return new Promise<void>((resolve) => {
      const img = new Image();
      let encerrado = false;
      const fim = (): void => {
        if (encerrado) return;
        encerrado = true;
        resolve();
      };
      img.addEventListener('load', fim, { once: true });
      img.addEventListener('error', fim, { once: true });
      img.src = src;
      if (img.complete) fim();
      window.setTimeout(fim, 2000);
    });
  }

  if (typeof window.requestIdleCallback === 'function') {
    window.requestIdleCallback(precarregar);
  } else {
    window.addEventListener('load', precarregar, { once: true });
  }

  botoes.forEach((botao) => {
    botao.addEventListener('click', () => {
      const alvo = botao.dataset.alvo;
      const imagem = botao.dataset.imagem;
      if (!alvo || !imagem) return;

      const foto = document.getElementById(alvo) as HTMLImageElement | null;
      if (!foto || foto.dataset.atual === imagem) return;
      foto.dataset.atual = imagem;

      botao.parentElement?.querySelectorAll('.acab').forEach((b) => b.classList.remove('ativo'));
      botao.classList.add('ativo');

      foto.classList.add('trocando');

      /* Só devolve a opacidade quando a nova imagem terminou de carregar e o
         esmaecimento passou — é o que tirava o "seco e com atraso". O prazo
         máximo existe para que a foto nunca fique invisível se o load falhar. */
      const esmaecimento = new Promise<void>((resolve) => window.setTimeout(resolve, 180));

      void Promise.all([carregada(imagem), esmaecimento]).then(() => {
        if (foto.dataset.atual !== imagem) return;
        foto.src = imagem;
        foto.classList.remove('trocando');
      });
    });
  });
</script>
