---
import { empresa } from '../data/empresa';
---

<section class="secao secao--nevoa" id="produtos">
  <div class="env">
    <div class="rev">
      <p class="etiqueta">Linha de produtos</p>
      <h2 class="titulo">O que a Vetralumi fabrica</h2>
    </div>

    {
      empresa.produtos.map((p, idx) => (
        <article class="produto rev" style={`--atraso:${(idx * 0.06).toFixed(2)}s`}>
          <div class="produto-visual">
            {p.lancamento && <span class="selo">Lançamento</span>}
            <img
              id={`foto-${p.id}`}
              src={p.imagem}
              alt={`${p.nome} Vetralumi`}
              width="532"
              height="620"
              loading="lazy"
            />
          </div>

          <div class="produto-texto">
            <p class="subtitulo">{p.subtitulo}</p>
            <h3>{p.nome}</h3>
            <p class="descricao">{p.descricao}</p>

            {p.acabamentos && (
              <div class="acabamentos">
                <span class="acab-rotulo">Acabamentos</span>
                <div class="acab-lista">
                  {p.acabamentos.map((a, i) => (
                    <button
                      class:list={['acab', { ativo: i === 1 }]}
                      data-imagem={a.imagem}
                      data-alvo={`foto-${p.id}`}
                      type="button"
                    >
                      <span class="chip" style={`background:${a.chip}`} aria-hidden="true" />
                      {a.nome}
                      {a.novidade && <em>novo</em>}
                    </button>
                  ))}
                </div>
              </div>
            )}

            <dl class="fichas">
              {p.especificacoes.map((e) => (
                <div class="ficha">
                  <dt>{e.rotulo}</dt>
                  <dd>{e.valor}</dd>
                </div>
              ))}
            </dl>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .produto {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(28px, 4vw, 56px);
    align-items: center;
    background: var(--branco);
    border: 1px solid var(--linha);
    border-radius: 3px;
    padding: clamp(22px, 3.2vw, 42px);
    margin-top: 40px;
  }

  .produto-visual {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 270px;
    background: #eff2f7;
    border-radius: 2px;
    padding: 22px;
  }

  .produto-visual img {
    width: auto;
    max-width: 100%;
    max-height: 252px;
    object-fit: contain;
    transition: opacity 0.28s var(--suave);
  }

  .produto-visual img.trocando {
    opacity: 0;
  }

  .selo {
    position: absolute;
    top: 13px;
    right: 13px;
    background: var(--azul);
    color: #fff;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 5px 9px;
    border-radius: 2px;
  }

  .subtitulo {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--azul);
  }

  .produto-texto h3 {
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-top: 10px;
  }

  .descricao {
    margin-top: 14px;
    color: var(--cinza);
    max-width: 52ch;
  }

  .acabamentos {
    margin-top: 26px;
  }

  .acab-rotulo {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cinza);
  }

  .acab-lista {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 10px;
  }

  .acab {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 14px;
    border: 1px solid var(--linha);
    border-radius: 2px;
    background: var(--branco);
    font-family: inherit;
    font-size: 14px;
    color: var(--tinta);
    cursor: pointer;
    transition:
      border-color 0.3s var(--suave),
      background 0.3s var(--suave);
  }

  .acab:hover {
    border-color: var(--azul);
  }

  .acab.ativo {
    border-color: var(--azul);
    background: var(--azul-fraco);
  }

  .acab em {
    font-style: normal;
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--azul);
  }

  .chip {
    width: 13px;
    height: 13px;
    border-radius: 50%;
    border: 1px solid var(--linha);
    flex: none;
  }

  .fichas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(155px, 1fr));
    gap: 1px;
    background: var(--linha);
    border: 1px solid var(--linha);
    border-radius: 2px;
    margin-top: 28px;
  }

  .ficha {
    background: var(--branco);
    padding: 14px 16px;
  }

  .ficha dt {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cinza);
  }

  .ficha dd {
    margin-top: 5px;
    font-size: 15px;
    font-weight: 500;
  }

  @media (max-width: 860px) {
    .produto {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const botoes = document.querySelectorAll<HTMLButtonElement>('.acab');

  botoes.forEach((botao) => {
    botao.addEventListener('click', () => {
      const alvo = botao.dataset.alvo;
      const imagem = botao.dataset.imagem;
      if (!alvo || !imagem) return;

      const foto = document.getElementById(alvo) as HTMLImageElement | null;
      if (!foto) return;

      botao.parentElement?.querySelectorAll('.acab').forEach((b) => b.classList.remove('ativo'));
      botao.classList.add('ativo');

      foto.classList.add('trocando');
      window.setTimeout(() => {
        foto.src = imagem;
        foto.classList.remove('trocando');
      }, 180);
    });
  });
</script>
