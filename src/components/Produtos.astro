---
import { empresa } from '../data/empresa';

const produto = empresa.produtos[0]!;
---

<section class="secao secao--nevoa" id="produtos">
  <div class="env">
    <div class="rev">
      <p class="etiqueta">Linha de produtos</p>
      <h2 class="titulo">{produto.nome}</h2>
      <p class="chamada-secao">{produto.descricao}</p>
    </div>

    <div class="acabamentos">
      {
        produto.acabamentos.map((a, i) => (
          <article class="peca rev" style={`--atraso:${(i * 0.09).toFixed(2)}s`}>
            {a.novidade && <span class="selo">Novidade</span>}
            <div class="peca-foto">
              <img src={a.imagem} alt={`Dobradiça Vetralumi ${a.nome}`} width="100" height="100" loading="lazy" />
            </div>
            <div class="peca-pe">
              <span class="chip" style={`background:${a.chip}`} aria-hidden="true" />
              <span class="peca-nome">{a.nome}</span>
            </div>
          </article>
        ))
      }
    </div>

    <p class="nota rev">
      Outras linhas em breve. Para consultar disponibilidade ou uma peça específica, fale direto
      com a loja.
    </p>
  </div>
</section>

<style>
  .acabamentos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 18px;
    margin-top: 46px;
  }

  .peca {
    position: relative;
    background: var(--branco);
    border: 1px solid var(--linha);
    border-radius: 3px;
    padding: 34px 26px 22px;
    transition:
      opacity 0.8s var(--saida),
      transform 0.8s var(--saida),
      border-color 0.35s var(--suave),
      box-shadow 0.35s var(--suave);
  }

  .peca.visto:hover {
    border-color: var(--azul);
    box-shadow: 0 18px 40px -26px rgba(50, 95, 236, 0.65);
    transform: translateY(-5px);
  }

  .peca-foto {
    display: grid;
    place-items: center;
    height: 150px;
  }

  .peca-foto img {
    width: auto;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
    transition: transform 0.55s var(--saida);
  }

  .peca:hover .peca-foto img {
    transform: scale(1.07);
  }

  .peca-pe {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--linha);
  }

  .chip {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 1px solid var(--linha);
    flex: none;
  }

  .peca-nome {
    font-weight: 500;
    font-size: 16px;
  }

  .selo {
    position: absolute;
    top: 14px;
    right: 14px;
    background: var(--azul);
    color: #fff;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 5px 9px;
    border-radius: 2px;
  }

  .nota {
    margin-top: 30px;
    color: var(--cinza);
    font-size: 15px;
    max-width: 52ch;
  }
</style>
