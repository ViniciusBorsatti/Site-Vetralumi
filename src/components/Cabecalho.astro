---
import { empresa, linkWhatsapp } from '../data/empresa';

const secoes = [
  { href: '#produtos', rotulo: 'Produtos' },
  { href: '#aplicacoes', rotulo: 'Aplicações' },
  { href: '#rede', rotulo: 'Rede' },
  { href: '#contato', rotulo: 'Contato' },
];

const acao = empresa.whatsapp
  ? linkWhatsapp(empresa.whatsapp)
  : `tel:${empresa.telefone.e164}`;
---

<header class="topo" id="topo">
  <div class="env topo-int">
    <a class="marca" href="#" aria-label={`${empresa.nome}, início`}>
      <svg class="marca-v" viewBox="0 0 161 146" aria-hidden="true">
        <use href="#marca-v"></use>
      </svg>
      <span class="marca-texto">
        <strong>Vetralumi</strong>
        <em>componentes</em>
      </span>
    </a>

    <nav class="nav" aria-label="Seções do site">
      {secoes.map((s) => <a href={s.href}>{s.rotulo}</a>)}
    </nav>

    <button class="tema" id="tema" type="button" aria-label="Alternar tema" aria-pressed="false">
      <svg class="tema-sol" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="4.2" />
        <path d="M12 2.6v2.2M12 19.2v2.2M4.2 12H2M22 12h-2.2M6.5 6.5 4.9 4.9M19.1 19.1l-1.6-1.6M17.5 6.5l1.6-1.6M4.9 19.1l1.6-1.6" />
      </svg>
      <svg class="tema-lua" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20.5 14.3A8.5 8.5 0 0 1 9.7 3.5a8.5 8.5 0 1 0 10.8 10.8z" />
      </svg>
    </button>

    <a class="btn btn--cheio topo-acao" href={acao} target="_blank" rel="noopener">
      Pedir orçamento
    </a>
  </div>
</header>

<style>
  .topo {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    background: var(--topo-fundo);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--linha);
    transition:
      background 0.4s var(--suave),
      box-shadow 0.4s var(--suave);
  }

  .topo.fixado {
    background: var(--topo-fixo);
    box-shadow: 0 1px 0 var(--linha), 0 10px 30px -24px var(--sombra);
  }

  .topo-int {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: var(--topo);
  }

  .marca {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .marca-v {
    width: 30px;
    height: 27px;
    color: var(--azul);
    flex: none;
  }

  .marca-texto {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .marca-texto strong {
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .marca-texto em {
    font-style: normal;
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--cinza-claro);
    margin-top: 3px;
  }

  .nav {
    display: flex;
    gap: 28px;
    margin-left: auto;
    margin-right: 4px;
  }

  .nav a {
    position: relative;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--cinza);
    text-decoration: none;
    padding-bottom: 3px;
    transition: color 0.3s;
  }

  .nav a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: var(--azul);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.4s var(--suave);
  }

  .nav a:hover {
    color: var(--tinta);
  }

  .nav a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .topo-acao {
    padding: 11px 20px;
    font-size: 11px;
  }

  .tema {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    flex: none;
    padding: 0;
    background: transparent;
    border: 1px solid var(--linha);
    border-radius: 0;
    color: var(--cinza);
    cursor: pointer;
    transition:
      border-color 0.3s var(--suave),
      color 0.3s var(--suave);
  }

  .tema:hover {
    border-color: var(--azul);
    color: var(--azul-rotulo);
  }

  .tema svg {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Mostra o ícone do tema para onde o clique leva, igual ao aria-label:
     no claro aparece a lua ("ir para o escuro"), e no escuro o sol. */
  .tema-sol {
    display: none;
  }

  :global(:root[data-tema='escuro']) .tema-sol {
    display: block;
  }

  :global(:root[data-tema='escuro']) .tema-lua {
    display: none;
  }

  @media (max-width: 860px) {
    .nav {
      display: none;
    }
  }

  @media (max-width: 420px) {
    .marca-texto strong {
      font-size: 17px;
    }
    .topo-acao {
      padding: 10px 12px;
      font-size: 10px;
      letter-spacing: 0.04em;
    }
  }
</style>

<script>
  /* Tema. O valor inicial já foi resolvido no <head> para não piscar. */
  const raiz = document.documentElement;
  const botaoTema = document.getElementById('tema');

  function marcarTema(tema: string): void {
    raiz.dataset.tema = tema;
    const escuro = tema === 'escuro';
    botaoTema?.setAttribute('aria-pressed', String(escuro));
    botaoTema?.setAttribute('aria-label', escuro ? 'Mudar para o tema claro' : 'Mudar para o tema escuro');
  }

  marcarTema(raiz.dataset.tema === 'escuro' ? 'escuro' : 'claro');

  botaoTema?.addEventListener('click', () => {
    const novo = raiz.dataset.tema === 'escuro' ? 'claro' : 'escuro';
    marcarTema(novo);
    try {
      localStorage.setItem('tema', novo);
    } catch (e) {
      /* navegação privada: o tema vale só para esta visita */
    }
  });

  /* Enquanto a pessoa não escolher, o site acompanha o sistema. */
  const preferencia = window.matchMedia('(prefers-color-scheme: dark)');
  preferencia.addEventListener('change', (e) => {
    let salvo: string | null = null;
    try {
      salvo = localStorage.getItem('tema');
    } catch (err) {
      /* sem acesso ao armazenamento: segue o sistema */
    }
    if (salvo !== 'claro' && salvo !== 'escuro') marcarTema(e.matches ? 'escuro' : 'claro');
  });

  const topo = document.getElementById('topo');
  let pendente = false;

  function aoRolar(): void {
    topo?.classList.toggle('fixado', window.scrollY > 40);
    pendente = false;
  }

  window.addEventListener(
    'scroll',
    () => {
      if (!pendente) {
        pendente = true;
        window.requestAnimationFrame(aoRolar);
      }
    },
    { passive: true },
  );

  aoRolar();
</script>
